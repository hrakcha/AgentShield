# Copy this file to .env and fill in values only if you enable an external classifier.
# The MVP heuristic engine works without any API key.

# Optional: later plug-in for Layer 2 (not required for demo)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# App
APP_HOST=127.0.0.1
APP_PORT=8000
MAX_INPUT_CHARS=12000
